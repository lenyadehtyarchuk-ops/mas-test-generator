# OpenAI-compatible endpoint. For Ollama: http://host.docker.internal:11434/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
# auto: JSON Schema, then JSON mode only if the API rejects the format.
# json: JSON mode; prompt: schema in prompt only (for older providers).
LLM_OUTPUT_MODE=auto
LLM_TIMEOUT=90
AGENT_HTTP_TIMEOUT=240
RUNNER_EXECUTION_TIMEOUT=10
